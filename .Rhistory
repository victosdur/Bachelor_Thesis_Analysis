union_hogar %<>% select(DB030,DB040,DB090,HY020,HY010,vhRentaa,vhPobreza,HX040,HX240,vhMATDEP)
y=union_hogar %>% group_by(DB040) %>% summarise(renta_hogar=sum(DB090*vhRentaa)/sum(DB090),
