Unimos los datos de los indicadores por comunidad para 2009 y 2020
```{r}
evolucion=rbind(xb,yb)
evolucion$Año=rep(c(2020,2009),each=19)
evolucion$Año=as.character(evolucion$Año) #necesario que este como caracter para el grafico evolucion
evolucion %<>% pivot_longer(-c(Año,DB040),names_to = "Indicador",values_to = "valor")
table(evolucion$Indicador)
evolucion$valor = round(evolucion$valor,2)
#damos nombre a las comunidades
library(giscoR)
nuts2=gisco_get_nuts(year=2016,resolution=20,nuts_level = 2) %>% select(NUTS_ID,NAME_LATN)
which(nuts2$NUTS_ID=="ES11")
which(nuts2$NUTS_ID=="ES70")
evolucion$comunidad=rep(rep(nuts2[187:205,2],each=6),2)

evolucion
tabla=evolucion %>% mmtable(valor) + header_top(comunidad) + header_left(Indicador) + header_left_top(Año) +
  header_format(comunidad,list(cell_text(transform = "capitalize"))) +
  table_format(locations=list(cells_body(rows=c(2,8))),style=list(cell_borders(sides="top",color="yellow"))) 
tabla %>% gt::tab_header(title="Indicadores de Pobreza y Desigualdad",subtitle = "Desagregados por comunidades de España y Año")
```
